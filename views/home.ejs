<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Conferencing App</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="navbar">
            <div class="navbar-left">
                <h1 class="logo">ZOOM</h1>
                <ul class="nav-links">
                <li><a href="#">Products<i class="fa-solid fa-angle-down"></i></a></li>
                <li><a href="#"><i class="fa-solid fa-diamond"></i>AI</a></li>
                <li><a href="#">Solutions<i class="fa-solid fa-angle-down"></i></a></li>
                <li><a href="#">Pricing<i class="fa-solid fa-angle-down"></i></a></li>
                <div><a href="/new" class="meet-link">Meet</a></div>
                </ul>
            </div>  
            <div class="navbar-right">
                <div class="search"><i class="fa-solid fa-magnifying-glass"></i></div>
                <div>Meet</div>
                <div><a href="/login">Sign In</a></div>
                <div>Support</div>
                <div><button class="btn-outline">Contact Sales</button></div>
                <div><a href="/signup" class="btn-primary">Sign up Free</a></div>
            </div>
        </div>
        <div class="banner">
            <p>Join the Zoom Scale-UP Summit EMEA -grow with AI Tools</p>
            <button class="btn-primary">Register now</button>
        </div>
        <div class="hero">
            <h1>Find out what's possible<br> when work connects</h1>
            <h6>Whether you're chatting with teammates or supporting customers,Zoom makes it easier to connect,collaborate,and reach goals-all with built-in AI doing the heavy listing</h6>
        </div>
        <div class="ai-section">
            <div class="ai-card">
                <div class="ai-label"><p>AI Companion</p>
                </div>
                <div class="ai-prompt">
                    <h5>Daily Standup</h5>
                    <h3>List my action items from this meeting</h3>
                </div>
            </div>
            <div class="notes-card">
                <div class="notes-header">
                    <h3>My Notes</h3>
                </div>
                <div class="notes-body">
                    <h4>My Notes</h4>
                    <hr>
                    <h4>Transcript</h4>
                    <hr>
                    <h2>Share budget expectations with Rob</h2>
                </div>
            </div>
            <div class="Whiteboard">
                <div class="Whiteboard-header">
                    <span><i class="fa-solid fa-pen"></i></span>
                    <p>Whiteboard</p>
                </div>
                <div class="Whiteboard-body">
                    <div class="toolbar">
                        <div><i class="fa-solid fa-diamond"></i></div>
                        <div><i class="fa-solid fa-pencil"></i></div>
                        <div><i class="fa-regular fa-square"></i></div>
                        <div><i class="fa-solid fa-t"></i></div>
                    </div>
                    <div class="participants">
                        <div class="participant">Madison Miller</div>
                        <div class="participant">Brian Kim</div>
                        <div class="participant">Marketing Huddle</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</body>
</html>